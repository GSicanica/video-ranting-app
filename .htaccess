# YouTube Rating API - HawkHost Configuration
# Apache configuration for shared hosting

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# CORS Headers - Restrictive CORS policy
<IfModule mod_headers.c>
    # IMPORTANT: Do NOT use wildcard (*) in production!
    # Set CORS_ALLOWED_ORIGINS environment variable with comma-separated origins
    # Example: SetEnv CORS_ALLOWED_ORIGINS "https://tmbv-hms.com,https://app.tmbv-hms.com"

    # Dynamic CORS handling - allows only configured origins
    SetEnvIf Origin "^https://tmbv-hms\.com$" CORS_ORIGIN=$0
    SetEnvIf Origin "^https://.*\.tmbv-hms\.com$" CORS_ORIGIN=$0

    # For local development only (remove in production)
    SetEnvIf Origin "^http://localhost(:[0-9]+)?$" CORS_ORIGIN=$0

    # Only set CORS headers if origin is in whitelist
    Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-CSRF-Token" env=CORS_ORIGIN
    Header always set Access-Control-Max-Age "3600" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
    Header always append Vary "Origin"
    
    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"

    # Vary header for caching
    Header append Vary Accept-Encoding
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 1 minute"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>

# Handle OPTIONS requests for CORS preflight
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Rewrite adminPanel token files to .php
    RewriteRule ^adminPanel/([a-zA-Z0-9_]+)$ adminPanel/$1.php [L]
    
    # Respond to CORS preflight requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Default charset
AddDefaultCharset UTF-8

# PHP settings
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 60
    php_value max_input_time 60
    php_value memory_limit 128M
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Set default index files
DirectoryIndex index.php index.html

# Error pages (don't redirect HTML files)
# ErrorDocument 404 /index.php
# ErrorDocument 500 /index.php
