<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundle Identification -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>YouTube Ratings</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>5.0</string>
	<key>CFBundleVersion</key>
	<string>67</string>

	<!-- UI Configuration -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- Scene Management -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- Device Orientation -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- API Configuration -->
	<key>YT_BASE_URL</key>
	<string>https://api.youtuberating.app</string>
	<key>YT_DATA_BASE_URL</key>
	<string>https://data.youtuberating.app</string>

	<!-- Network Security -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>api.youtuberating.app</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<true/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
			<key>data.youtuberating.app</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<true/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- Local Network Access -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>YouTube Ratings needs access to your local network to discover and connect to devices for real-time synchronization.</string>
	<key>NSBonjourServiceTypes</key>
	<array>
		<string>_http._tcp</string>
		<string>_https._tcp</string>
	</array>
	<key>NSAllowsLocalNetworking</key>
	<true/>

	<!-- Privacy & Permissions -->
	<key>NSCameraUsageDescription</key>
	<string>YouTube Ratings needs camera access to enable video streaming features and live content creation.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>YouTube Ratings needs microphone access for voice calls, live streaming, and audio content recording.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>YouTube Ratings needs access to your photo library to share videos and images.</string>
	<key>NSPhotoLibraryAddOnlyUsageDescription</key>
	<string>YouTube Ratings needs permission to save videos and images to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>YouTube Ratings can use your location to provide location-based content recommendations.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>YouTube Ratings uses your location in the background to enhance your experience with location-based features.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>YouTube Ratings needs access to your calendar to schedule content viewing and reminders.</string>
	<key>NSContactsUsageDescription</key>
	<string>YouTube Ratings needs access to your contacts to help you find and follow friends.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>This app uses tracking to personalize your content recommendations and improve your experience.</string>
	<key>NSSiriUsageDescription</key>
	<string>YouTube Ratings can use Siri to help you search and play videos hands-free.</string>

	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>processing</string>
	</array>

	<!-- URL Schemes for Deep Linking -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Video URL</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>youtube</string>
				<string>youtube-ratings</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Universal Links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>https</string>
			</array>
		</dict>
	</array>

	<!-- Associated Domains for Universal Links -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:youtuberating.app</string>
		<string>applinks:www.youtuberating.app</string>
		<string>applinks:api.youtuberating.app</string>
	</array>

	<!-- Document Types -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternative</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.video</string>
				<string>com.apple.quicktime-movie</string>
				<string>org.3gpp.mobile-multimedia-presentation</string>
			</array>
		</dict>
	</array>

	<!-- File Sharing -->
	<key>UIFileSharingEnabled</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Device Capabilities -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
		<string>arm64</string>
	</array>

	<!-- Security -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
