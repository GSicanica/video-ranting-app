<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug override (full copy of release config + extra dev exception). -->

    <!-- Strict base configuration - no cleartext by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production API domain - strict HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tmbv-hms.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- YouTube and related services - HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">yt5s.io</domain>
        <domain includeSubdomains="true">yt1s.com</domain>
        <domain includeSubdomains="true">co.wuk.sh</domain>
        <domain includeSubdomains="true">youtube.com</domain>
        <domain includeSubdomains="true">googlevideo.com</domain>
        <domain includeSubdomains="true">ytimg.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Debug-only: allow cleartext ws:// on port 7880 if needed. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">46.225.108.6</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
